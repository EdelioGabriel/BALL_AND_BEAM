{
    "folders": [
        {
            "name": "root",
            "path": "."
        },
        {
            "name": "firmware",
            "path": "firmware"
        },
        {
            "name": "pinn",
            "path": "pinn"
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder:pinn}/.venv/Scripts/python.exe",
        "python.terminal.activateEnvironment": true,
        "editor.formatOnSave": true,
        "[cpp]": {
            "editor.defaultFormatter": "ms-vscode.cpptools"
        },
        "[python]": {
            "editor.defaultFormatter": "ms-python.python"
        }
    },
    "extensions": {
        "recommendations": [
            "platformio.platformio-ide",
            "ms-python.python",
            "ms-python.vscode-pylance"
        ]
    }
}